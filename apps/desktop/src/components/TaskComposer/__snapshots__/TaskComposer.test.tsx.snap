exports[`TaskComposer > renders the bounded sharing contract without starting a task 1`] = `
"<form class="_composer_22c3ff" aria-label="定义本地任务"><header class="_header_22c3ff"><span class="_step_22c3ff" aria-hidden="true">01</span><div><p class="_eyebrow_22c3ff">Local task / bounded input</p><h3>把目标交给本机 Codex</h3><p class="_description_22c3ff">Rivloom 会为这次执行创建隔离 worktree，并只把下面的有界任务正文交给 Runtime。</p></div><span class="_boundary_22c3ff">6 / 1,000-byte run guard</span></header><div class="_fields_22c3ff"><div class="_field_22c3ff"><span class="_fieldHeading_22c3ff"><label for="local-task-goal"><strong>任务目标</strong></label><span>0 / 4,096 bytes</span></span><textarea id="local-task-goal" rows="5" placeholder="清楚描述要完成的结果，例如：修复登录恢复并补充回归测试。"></textarea><small>描述可验收的结果，不要粘贴 Token、密钥或无界日志。</small></div><div class="_field_22c3ff"><span class="_fieldHeading_22c3ff"><label for="local-task-constraints"><strong>执行约束（每行一条）</strong></label><span>0 / 32</span></span><textarea id="local-task-constraints" rows="4" placeholder="保持现有存储兼容
不修改 codex-rs"></textarea><small>最多 32 条；每条 1 KiB，合计 8 KiB。空行会被忽略。</small></div></div><footer class="_footer_22c3ff"><div class="_sharing_22c3ff"><span aria-hidden="true">↗</span><div aria-live="polite"><strong>只发送目标与约束</strong><p>项目绝对路径、Runtime 凭据与完整日志不会进入任务正文。</p></div></div><button type="submit" disabled="" aria-busy="false"><span aria-hidden="true">▶</span>启动本地任务</button></footer></form>"
`;
