set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

test:
    corepack pnpm test

check:
    corepack pnpm test
    corepack pnpm build

fmt:
    corepack pnpm format:fix
    cargo fmt --manifest-path src-tauri/Cargo.toml

test-rust:
    cargo test --manifest-path src-tauri/Cargo.toml
    cargo test --manifest-path src-tauri/Cargo.toml --lib --features test-tauri-commands project::commands
    cargo test --manifest-path src-tauri/Cargo.toml --lib --features test-tauri-commands collaboration::commands
    cargo test --manifest-path src-tauri/Cargo.toml --lib --features test-tauri-commands collaboration::node_commands

check-rust:
    cargo check --manifest-path src-tauri/Cargo.toml
